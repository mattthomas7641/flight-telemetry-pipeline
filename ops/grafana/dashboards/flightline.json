{
  "uid": "flightline",
  "title": "Flightline \u2014 telemetry pipeline",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Frames/s accepted",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(flightline_ingest_frames_total{result=\"accepted\"}[1m]))"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Rows/s to lake",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(flightline_writer_rows_total[1m]))"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "p99 ingest\u2192page",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(flightline_alert_latency_seconds_bucket[5m])))"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Active critical alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(flightline_active_alerts{severity=\"critical\"})"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Ingest throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(flightline_ingest_frames_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Consumer-group lag (KEDA scales writers on this)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (group) (flightline_stream_lag_entries)",
          "legendFormat": "{{group}}"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Rows written by classification",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (classification) (rate(flightline_writer_rows_total[1m]))",
          "legendFormat": "{{classification}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Latency percentiles",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(flightline_ingest_request_seconds_bucket[1m])))",
          "legendFormat": "ingest p99"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(flightline_ingest_to_durable_seconds_bucket[1m])))",
          "legendFormat": "ingest\u2192durable p99"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(flightline_alert_latency_seconds_bucket[5m])))",
          "legendFormat": "ingest\u2192page p99"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Alert transitions",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rule, severity, action) (increase(flightline_alerts_total[1m]))",
          "legendFormat": "{{rule}} {{severity}} {{action}}"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Quarantine by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(flightline_ingest_quarantined_total[1m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "id": 10
    }
  ]
}